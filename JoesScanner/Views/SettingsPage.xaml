<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="JoesScanner.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:JoesScanner.ViewModels"
    xmlns:models="clr-namespace:JoesScanner.Models"
    xmlns:controls="clr-namespace:JoesScanner.Views.Controls"
    xmlns:corecontrols="clr-namespace:JoesScanner.Controls"
    x:Name="SettingsPageRoot"
    x:DataType="vm:SettingsViewModel"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False"
    BackgroundColor="{StaticResource TabStripNavy}">
    <ContentPage.Resources>
        <Style x:Key="CompactToggleStyle" TargetType="controls:CompactToggleSwitch">
            <Setter Property="HorizontalOptions" Value="End" />
            <Setter Property="VerticalOptions" Value="Center" />
            <Setter Property="WidthRequest" Value="56" />
            <Setter Property="HeightRequest" Value="20" />
            <Setter Property="OnColor" Value="{StaticResource Primary}" />
            <Setter Property="ThumbColor" Value="White" />
        </Style>
        <Style x:Key="SettingsCardStyle" TargetType="Border">
            <Setter Property="Stroke" Value="{AppThemeBinding Light=#e5e7eb, Dark=#374151}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="StrokeShape" Value="RoundRectangle 8" />
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#ffffff, Dark=#111827}" />
            <Setter Property="Padding" Value="12,8" />
        </Style>
        <Style x:Key="SettingsCardContentStyle" TargetType="VerticalStackLayout">
            <Setter Property="Spacing" Value="8" />
        </Style>
        <Style x:Key="SettingsCardHeaderStyle" TargetType="Grid">
            <Setter Property="MinimumHeightRequest" Value="40" />
            <Setter Property="ColumnSpacing" Value="12" />
        </Style>
        <Style x:Key="SettingsCardTitleStyle" TargetType="Label">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="VerticalOptions" Value="Center" />
            <Setter Property="VerticalTextAlignment" Value="Center" />
            <Setter Property="LineBreakMode" Value="WordWrap" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light=#111827, Dark=#e5e7eb}" />
        </Style>
        <Style x:Key="SettingsCardChevronStyle" TargetType="Label">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light=#111827, Dark=#e5e7eb}" />
            <Setter Property="WidthRequest" Value="20" />
            <Setter Property="HorizontalOptions" Value="End" />
            <Setter Property="HorizontalTextAlignment" Value="Center" />
            <Setter Property="VerticalOptions" Value="Center" />
            <Setter Property="VerticalTextAlignment" Value="Center" />
            <Setter Property="Margin" Value="0" />
        </Style>
        <!-- Platform helper resources (avoid WinUI= property assignment which can be trimmed on iOS) -->
        <OnPlatform x:Key="IsWinUIOnly" x:TypeArguments="x:Boolean" Default="False">
            <On Platform="WinUI" Value="True" />
        </OnPlatform>
    </ContentPage.Resources>

<!-- Scroll so content works on phone and desktop -->
    <controls:SettingsLayoutGrid Padding="5,0,5,5" RowDefinitions="0,*" RowSpacing="0">

        <ScrollView Grid.Row="1">
            <Border
                        Padding="2"
                        BackgroundColor="{AppThemeBinding Light=White, Dark=#020617}"
                        StrokeThickness="0">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>

                <VerticalStackLayout Style="{StaticResource SettingsCardContentStyle}">

                    <!-- HEADER PANEL -->
                    <Border
                                BackgroundColor="#0D0D28"
                                Padding="2,0"
                                StrokeThickness="0"
                                HorizontalOptions="Fill">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>

                        <Grid Padding="8,6">

                        <VerticalStackLayout
                            Spacing="0"
                            VerticalOptions="Center">

                            <!-- Title and tagline -->
                            <Grid RowDefinitions="Auto,Auto,Auto,Auto"
                                ColumnDefinitions="*,Auto">

                                <!-- Row 0: Title (left) + Version (right) -->
                                <Label
                                    Grid.Row="0"
                                                                        Text="Adjust connection, call list behavior, filters and theme"
                                    FontSize="12"
                                    LineBreakMode="WordWrap"
                                    TextColor="White" />
                                <Label
                                    x:Name="AppVersionLabel"
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Text=""
                                    FontSize="12"
                                    VerticalOptions="Center"
                                    HorizontalOptions="Center"
                                    TextColor="White"
                                    IsVisible="False" />

                            </Grid>

                            <!-- Header status -->
                            <Grid
                                        ColumnDefinitions="*"
                                        HorizontalOptions="Fill"
                                        Padding="0,0,0,0">

                                <VerticalStackLayout
                                            Spacing="0"
                                            HorizontalOptions="FillAndExpand"
                                            VerticalOptions="Center">

                                    <Label
                                                Text="Validating server..."
                                                IsVisible="{Binding ShowServerValidationProgressHeader}"
                                                FontSize="14"
                                                TextColor="#cbd5e1"
                                                HorizontalOptions="FillAndExpand"
                                                LineBreakMode="WordWrap"
                                                MaxLines="2" />

                                    <Label
                                                Text="{Binding ValidationSuccessHeaderText}"
                                                IsVisible="{Binding ShowServerValidationSuccessHeader}"
                                                FontSize="14"
                                                TextColor="{AppThemeBinding Light=#16a34a, Dark=#22c55e}"
                                                HorizontalOptions="FillAndExpand"
                                                LineBreakMode="WordWrap"
                                                MaxLines="2" />

                                    <Label
                                                Text="{Binding ServerValidationMessage}"
                                                IsVisible="{Binding ShowServerValidationErrorHeader}"
                                                FontSize="14"
                                                TextColor="{AppThemeBinding Light=#dc2626, Dark=#f87171}"
                                                HorizontalOptions="FillAndExpand"
                                                LineBreakMode="WordWrap"
                                                MaxLines="3" />

                                </VerticalStackLayout>

                            </Grid>

                        </VerticalStackLayout>

                        </Grid>
                    </Border>

                    <!-- CONNECTION CARD -->
                    <Border Style="{StaticResource SettingsCardStyle}">

    <VerticalStackLayout Style="{StaticResource SettingsCardContentStyle}">

        <!-- Header -->
        <Grid Style="{StaticResource SettingsCardHeaderStyle}"
            x:Name="ConnectionHeaderGrid"
            ColumnDefinitions="Auto,*,Auto">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnConnectionHeaderTapped" />
            </Grid.GestureRecognizers>

            <Label Style="{StaticResource SettingsCardTitleStyle}"
                Grid.Column="0"
                Text="Server Connections" />

            <Label
                Grid.Column="1"
                Text="{Binding SubscriptionSummary}"
                IsVisible="{Binding ShowSubscriptionSummary}"
                FontSize="10"
                TextColor="{AppThemeBinding Light=#16a34a, Dark=#22c55e}"
                HorizontalTextAlignment="End"
                VerticalOptions="Center"
                LineBreakMode="WordWrap" />

            <Label
                x:Name="ConnectionChevronLabel"
                Style="{StaticResource SettingsCardChevronStyle}"
                Grid.Column="2"
                Text="▶" />
        </Grid>

        <Label
            x:Name="ConnectionDescriptionLabel"
            IsVisible="False"
            Text="Configure recorders and choose which ones to monitor."
            FontSize="12"
            TextColor="{AppThemeBinding Light=#6b7280, Dark=#9ca3af}"
            LineBreakMode="WordWrap"
            MaxLines="3">
            <Label.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnConnectionHeaderTapped" />
            </Label.GestureRecognizers>
        </Label>

        <!-- Fields -->
        <controls:DeferredContentView
            x:Name="ConnectionFieldsGrid"
            IsVisible="False">
            <controls:DeferredContentView.ContentTemplate>
                <DataTemplate x:DataType="vm:SettingsViewModel">
                    <VerticalStackLayout Spacing="8">
                        <VerticalStackLayout Spacing="6" BindableLayout.ItemsSource="{Binding ScannerConnections}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:ScannerConnectionRow">
                                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="3" ColumnSpacing="6">
                                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                            <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="12"
                                                   LineBreakMode="TailTruncation" />
                                            <Label Text="{Binding Endpoint}" FontSize="11" LineBreakMode="TailTruncation" />
                                            <HorizontalStackLayout Spacing="5">
                                                <BoxView WidthRequest="8" HeightRequest="8" CornerRadius="4"
                                                         VerticalOptions="Center" Color="{Binding StatusColor}" />
                                                <Label Text="{Binding StatusText}" FontSize="11"
                                                       TextColor="{AppThemeBinding Light=#374151, Dark=#e5e7eb}" />
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>
                                        <Switch Grid.Column="1" IsToggled="{Binding Enabled, Mode=OneWay}"
                                                VerticalOptions="Center" Toggled="OnScannerConnectionToggled"
                                                SemanticProperties.Description="{Binding Name, StringFormat='Monitor {0}'}" />
                                        <FlexLayout Grid.Row="1" Grid.ColumnSpan="2" Wrap="Wrap" AlignItems="Center">
                                            <Button Text="↑" FontSize="12" Style="{StaticResource SecondaryPillButtonStyle}"
                                                    IsEnabled="{Binding CanMoveUp}" Clicked="OnScannerConnectionMoveUp"
                                                    SemanticProperties.Description="{Binding Name, StringFormat='Move {0} up'}" />
                                            <Button Text="↓" FontSize="12" Style="{StaticResource SecondaryPillButtonStyle}"
                                                    IsEnabled="{Binding CanMoveDown}" Clicked="OnScannerConnectionMoveDown"
                                                    SemanticProperties.Description="{Binding Name, StringFormat='Move {0} down'}" />
                                            <Button Text="Edit" FontSize="12" Style="{StaticResource SecondaryPillButtonStyle}"
                                                    Clicked="OnScannerConnectionEdit" />
                                            <Button Text="Share / Manage Listing" FontSize="12" IsVisible="{Binding CanShare}"
                                                    Clicked="OnScannerConnectionShare" Style="{StaticResource SecondaryPillButtonStyle}" />
                                            <Button Text="Review Directory Update" FontSize="12" IsVisible="{Binding HasDirectoryUpdate}"
                                                    Clicked="OnScannerConnectionReviewDirectory" Style="{StaticResource SecondaryPillButtonStyle}" />
                                            <Button Text="Remove" FontSize="12" Style="{StaticResource SecondaryPillButtonStyle}"
                                                    Clicked="OnScannerConnectionRemove" />
                                        </FlexLayout>
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <FlexLayout Wrap="Wrap">
                            <Button Text="Add server" AutomationId="AddScannerConnection" Margin="0,0,6,0"
                                    Clicked="OnScannerConnectionAdd" Style="{StaticResource PillButtonStyle}" />
                            <Button Text="Refresh directory" IsEnabled="{Binding CanRefreshDirectory}"
                                    Command="{Binding RefreshDirectoryServersCommand}" Style="{StaticResource SecondaryPillButtonStyle}" />
                        </FlexLayout>
                        <Label Text="{Binding DirectoryStatusText}"
                               TextColor="{AppThemeBinding Light=#6b7280, Dark=#9ca3af}" FontSize="11" />

                        <VerticalStackLayout IsVisible="{Binding ScannerEditorOpen}" Spacing="6">
                            <Label Text="{Binding ScannerEditorTitle}" FontSize="13" FontAttributes="Bold" />
                            <Picker x:Name="ServerPicker" IsVisible="{Binding CanChooseScannerSource}"
                                    ItemsSource="{Binding DirectoryServers}" SelectedItem="{Binding SelectedDirectoryServer}"
                                    ItemDisplayBinding="{Binding DisplayName}" Focused="OnServerPickerFocused" FontSize="12" />
                            <VerticalStackLayout IsVisible="{Binding CanEditScannerAddress}" Spacing="4">
                                <Entry Text="{Binding ScannerName}" Placeholder="Server name" FontSize="12" />
                                <Entry x:Name="ServerUrlEntry" Text="{Binding ServerUrl, UpdateSourceEventName=Unfocused}"
                                       Placeholder="Recorder URL" Keyboard="Url" FontSize="12" />
                            </VerticalStackLayout>

                            <Grid ColumnDefinitions="Auto,*,Auto,*,Auto" ColumnSpacing="6">
                                <Label Text="User" FontSize="12" VerticalOptions="Center" />
                                <Entry x:Name="BasicAuthUsernameEntry" Grid.Column="1" Placeholder="username"
                                       Text="{Binding BasicAuthUsername, UpdateSourceEventName=Unfocused}"
                                       IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" FontSize="12" />
                                <Label Grid.Column="2" Text="Pass" FontSize="12" VerticalOptions="Center" />
                                <controls:CursorHidingEntry x:Name="BasicAuthPasswordEntry" Grid.Column="3"
                                                           Text="{Binding BasicAuthPassword, UpdateSourceEventName=Unfocused}"
                                                           Placeholder="password" IsPassword="{Binding IsBasicAuthPasswordHidden}"
                                                           HideCursorWhenPassword="True" IsSpellCheckEnabled="False"
                                                           IsTextPredictionEnabled="False" FontSize="12" />
                                <Button Grid.Column="4" Text="{Binding BasicAuthPasswordToggleText}"
                                        Command="{Binding ToggleBasicAuthPasswordVisibilityCommand}"
                                        Style="{StaticResource SecondaryPillButtonStyle}" />
                            </Grid>

                            <FlexLayout Wrap="Wrap" AlignItems="Center">
                                <Button Text="Save locally" AutomationId="SaveLocalScannerConnection" Margin="0,0,5,4"
                                        IsVisible="{Binding CanEditScannerAddress}" Clicked="OnScannerConnectionSaveLocal"
                                        Style="{StaticResource PillButtonStyle}" />
                                <Button Text="Validate" Margin="0,0,5,4" Clicked="OnValidateClicked"
                                        Style="{StaticResource PillButtonStyle}">
                                    <Button.Triggers>
                                        <DataTrigger TargetType="Button" Binding="{Binding ConnectionNeedsValidation}" Value="True">
                                            <Setter Property="BackgroundColor" Value="Red" />
                                            <Setter Property="TextColor" Value="White" />
                                        </DataTrigger>
                                    </Button.Triggers>
                                </Button>
                                <Button Text="Save directory server" Margin="0,0,5,4" IsVisible="{Binding CanSaveDirectoryConnection}"
                                        Clicked="OnScannerConnectionSaveDirectory" Style="{StaticResource SecondaryPillButtonStyle}" />
                                <Button Text="Cancel" Margin="0,0,0,4" Clicked="OnScannerConnectionCancel"
                                        Style="{StaticResource SecondaryPillButtonStyle}" />
                            </FlexLayout>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </DataTemplate>
            </controls:DeferredContentView.ContentTemplate>
        </controls:DeferredContentView>

    </VerticalStackLayout>
</Border>


                    <!-- AUTO CONNECT OPTIONS (WINDOWS ONLY) -->
                    <Border Style="{StaticResource SettingsCardStyle}">

                <VerticalStackLayout Style="{StaticResource SettingsCardContentStyle}">

                    <!-- Header -->
                    <Grid Style="{StaticResource SettingsCardHeaderStyle}"
                        x:Name="AutoplayHeaderGrid"
                        ColumnDefinitions="*,Auto">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnAutoplayHeaderTapped" />
                        </Grid.GestureRecognizers>

                        <Label Style="{StaticResource SettingsCardTitleStyle}"
                            Grid.Column="0"
                            Text="Autoplay options"
                             />

                        <Label
                            x:Name="AutoplayChevronLabel"
                            Style="{StaticResource SettingsCardChevronStyle}"
                            Grid.Column="1"
                            Text="▶" />
                    </Grid>

                    <!-- Body -->
                    <controls:DeferredContentView
                        x:Name="AutoplayFieldsGrid"
                        IsVisible="False">
                        <controls:DeferredContentView.ContentTemplate>
                            <DataTemplate x:DataType="vm:SettingsViewModel">
                                <Grid
                        RowDefinitions="Auto,Auto,Auto,Auto"
                        ColumnDefinitions="*,Auto"
                        RowSpacing="10"
                        
                        ColumnSpacing="12"
                        HorizontalOptions="FillAndExpand">

                        <Label
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="Autoplay (start playing calls when app opens)"
                            FontSize="12"
                            LineBreakMode="WordWrap"
                            VerticalOptions="Center"
                            HorizontalOptions="Fill" />

                        <controls:CompactToggleSwitch
                            Grid.Row="0"
                            Grid.Column="1"
                            IsToggled="{Binding AutoPlay}"
                            Style="{StaticResource CompactToggleStyle}" />


                        <Label
                            Grid.Row="1"
                            Grid.Column="0"
                            Text="Automatically start when Windows loads"
                            IsVisible="{StaticResource IsWinUIOnly}"
                            FontSize="12"
                            LineBreakMode="WordWrap"
                            VerticalOptions="Center"
                            HorizontalOptions="Fill" />

                        <controls:CompactToggleSwitch
                            Grid.Row="1"
                            Grid.Column="1"
                            IsToggled="{Binding WindowsStartWithWindows}"
                            IsVisible="{StaticResource IsWinUIOnly}"
                            Style="{StaticResource CompactToggleStyle}" />
                                </Grid>
                            </DataTemplate>
                        </controls:DeferredContentView.ContentTemplate>
                    </controls:DeferredContentView>
                </VerticalStackLayout>

</Border>

                    <!-- FILTERS CARD -->
                    <Border Style="{StaticResource SettingsCardStyle}">

    <VerticalStackLayout Style="{StaticResource SettingsCardContentStyle}">

        <!-- Header -->
        <Grid Style="{StaticResource SettingsCardHeaderStyle}" x:Name="FiltersHeaderGrid" ColumnDefinitions="*,Auto">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnFiltersHeaderTapped" />
            </Grid.GestureRecognizers>

            <Label Style="{StaticResource SettingsCardTitleStyle}"
                Grid.Column="0"
                Text="Talkgroup Filters" />

            <Label
                x:Name="FiltersChevronLabel"
                Style="{StaticResource SettingsCardChevronStyle}"
                Grid.Column="1"
                Text="▶" />
        </Grid>

        <!-- Body -->
        <controls:DeferredContentView x:Name="FiltersBodyLayout" IsVisible="False">
            <controls:DeferredContentView.ContentTemplate>
                <DataTemplate x:DataType="vm:SettingsViewModel">
                    <VerticalStackLayout Spacing="8">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <Label
                    Grid.Column="0"
                    Text="Mute or disable automatic audio by Receiver, Site, or Talkgroup."
                    FontSize="12"
                    Opacity="0.8"
                    VerticalOptions="Center"
                    TextColor="{AppThemeBinding Light=#4b5563, Dark=#d1d5db}" />

                <Button
                    Grid.Column="1"
                    Text="Sync"
                    Style="{StaticResource PillButtonStyle}"
                    VerticalOptions="Center"
                    HorizontalOptions="End"
                    Command="{Binding SyncTalkgroupFiltersCommand}"
                    IsEnabled="{Binding CanSyncTalkgroupFilters}" />
            </Grid>

            <VerticalStackLayout Spacing="6">
                <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="6" RowSpacing="4">
                    <Label
                        Grid.Row="0"
                        Grid.Column="0"
                        Text="Receiver > Site > Talkgroup"
                        FontSize="13"
                        FontAttributes="Bold"
                        VerticalOptions="Center" />

                    <Label
                        Grid.Row="0"
                        Grid.Column="1"
                        Text="Mute"
                        FontSize="13"
                        FontAttributes="Bold"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center"
                        VerticalOptions="Center" />

                    <Label
                        Grid.Row="0"
                        Grid.Column="2"
                        Text="Disable"
                        FontSize="13"
                        FontAttributes="Bold"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center"
                        VerticalOptions="Center" />

                    <Grid
                        Grid.Row="1"
                        Grid.Column="0"
                        RowDefinitions="Auto,Auto"
                        RowSpacing="4"
                        IsClippedToBounds="True">
                        <ScrollView
                            x:Name="FiltersTextScrollView"
                            Grid.Row="0"
                            Orientation="Horizontal"
                            HorizontalScrollBarVisibility="Never"
                            VerticalScrollBarVisibility="Never">
                            <VerticalStackLayout
                                Spacing="4"
                                BindableLayout.ItemsSource="{Binding FilterRules}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:FilterRule">
                                        <Label
                                            Text="{Binding DisplayKey}"
                                            Style="{StaticResource FilterRowLabelStyle}"
                                            HorizontalOptions="Start" />
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </ScrollView>

                        <Slider
                            x:Name="FiltersScrollSlider"
                            Grid.Row="1"
                            Minimum="0"
                            Maximum="400"
                            Value="0"
                            ThumbColor="{StaticResource Primary}"
                            MinimumTrackColor="{StaticResource Primary}"
                            MaximumTrackColor="{AppThemeBinding Light=#cbd5e1, Dark=#475569}"
                            Margin="8,0,8,0"
                            ValueChanged="OnFiltersScrollSliderValueChanged" />
                    </Grid>

                    <VerticalStackLayout
                        Grid.Row="1"
                        Grid.Column="1"
                        Spacing="4"
                        HorizontalOptions="Start"
                        BindableLayout.ItemsSource="{Binding FilterRules}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:FilterRule">
                                <Border
                                    Style="{StaticResource FilterMuteChipStyle}"
                                    BackgroundColor="{Binding MuteButtonBackgroundColor}"
                                    Stroke="{AppThemeBinding Light=#9ca3af, Dark=#6b7280}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnMuteFilterTapped" />
                                    </Border.GestureRecognizers>
                                    <Label
                                        Text="{Binding MuteButtonText}"
                                        Style="{StaticResource FilterActionChipTextStyle}"
                                        TextColor="{Binding MuteButtonTextColor}" />
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <VerticalStackLayout
                        Grid.Row="1"
                        Grid.Column="2"
                        Spacing="4"
                        HorizontalOptions="Start"
                        BindableLayout.ItemsSource="{Binding FilterRules}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:FilterRule">
                                <Border
                                    Style="{StaticResource FilterDisableChipStyle}"
                                    BackgroundColor="{Binding DisableButtonBackgroundColor}"
                                    Stroke="{AppThemeBinding Light=#9ca3af, Dark=#6b7280}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnDisableFilterTapped" />
                                    </Border.GestureRecognizers>
                                    <Label
                                        Text="{Binding DisableButtonText}"
                                        Style="{StaticResource FilterActionChipTextStyle}"
                                        TextColor="{Binding DisableButtonTextColor}" />
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Grid>
                <Label Text="{Binding FilterPageSummary}" FontSize="12" />
                <HorizontalStackLayout IsVisible="{Binding HasFilterPages}" Spacing="8">
                    <Button Text="Previous" Clicked="OnPreviousFilterPageClicked"
                            IsEnabled="{Binding CanShowPreviousFilterPage}" />
                    <Button Text="Next" Clicked="OnNextFilterPageClicked"
                            IsEnabled="{Binding CanShowNextFilterPage}" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
                    </VerticalStackLayout>
                </DataTemplate>
            </controls:DeferredContentView.ContentTemplate>
        </controls:DeferredContentView>

    </VerticalStackLayout>
</Border>

                    <!-- CALL CARD OPTIONS CARD -->
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <VerticalStackLayout Style="{StaticResource SettingsCardContentStyle}">
                            <Grid Style="{StaticResource SettingsCardHeaderStyle}" ColumnDefinitions="*,Auto">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnCallCardOptionsHeaderTapped" />
                                </Grid.GestureRecognizers>
                                <Label Style="{StaticResource SettingsCardTitleStyle}" Text="Call Card Options" />
                                <Label Grid.Column="1" x:Name="CallCardOptionsChevron"
                                       Style="{StaticResource SettingsCardChevronStyle}" Text="▶" />
                            </Grid>
                            <controls:DeferredContentView x:Name="CallCardOptionsBody" IsVisible="False">
                                <controls:DeferredContentView.ContentTemplate>
                                    <DataTemplate x:DataType="vm:SettingsViewModel">
                                        <VerticalStackLayout
                                            BindingContext="{Binding CallCardOptions, x:DataType=vm:SettingsViewModel}"
                                            x:DataType="vm:CallCardOptionsViewModel"
                                            Spacing="8">
                                            <Label Text="Preview" FontSize="12" FontAttributes="Bold" />
                                            <Border Stroke="{AppThemeBinding Light=#e5e7eb, Dark=#374151}" Padding="8"
                                                    StrokeShape="RoundRectangle 8">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                                                        <controls:CallCardMetadataLabel Metadata="{Binding Preview}" CardLayout="{Binding Draft}"
                                                            FontSize="14" LineBreakMode="WordWrap" />
                                                        <controls:CallCardMetadataLabel Metadata="{Binding Preview}" CardLayout="{Binding Draft}"
                                                            Section="Secondary" FontSize="12" LineBreakMode="WordWrap" />
                                                    </VerticalStackLayout>
                                                    <controls:CallCardDurationLabel Grid.Column="1"
                                                        Metadata="{Binding Preview}" CardLayout="{Binding Draft}"
                                                        FontSize="12" VerticalOptions="Start" />
                                                </Grid>
                                            </Border>
                                            <VerticalStackLayout Spacing="8" IsEnabled="{Binding CanEdit}">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                    <Label Text="Show call duration" FontSize="12" VerticalOptions="Center" />
                                                    <controls:CompactToggleSwitch Grid.Column="1"
                                                        Style="{StaticResource CompactToggleStyle}"
                                                        IsToggled="{Binding ShowDuration, Mode=TwoWay}"
                                                        SemanticProperties.Description="Show call duration in the top-right corner" />
                                                </Grid>
                                                <Picker Title="Field" ItemsSource="{Binding Fields}" SelectedItem="{Binding SelectedField}"
                                                    ItemDisplayBinding="{Binding Name, x:DataType=models:CallCardFieldOption}"
                                                    SemanticProperties.Description="Call card field" />
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                    <Label Text="{Binding PositionText}" FontSize="12" VerticalOptions="Center" />
                                                    <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                                                        <Label Text="Show field" FontSize="12" VerticalOptions="Center" />
                                                        <controls:CompactToggleSwitch
                                                            Style="{StaticResource CompactToggleStyle}"
                                                            IsToggled="{Binding ShowSelectedField, Mode=TwoWay}"
                                                            SemanticProperties.Description="Show selected field" />
                                                    </HorizontalStackLayout>
                                                </Grid>
                                                <Label Text="Turn off Show call duration to display Duration in a metadata section."
                                                        IsVisible="{Binding ShowDurationPlacementHint}" FontSize="12" LineBreakMode="WordWrap" />
                                                <Button Text="{Binding MoveSectionText}" Command="{Binding MoveSectionCommand}"
                                                        Style="{StaticResource SecondaryPillButtonStyle}" HorizontalOptions="Start" />
                                                <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*"
                                                      RowSpacing="6" ColumnSpacing="6">
                                                    <Button Text="Left" Command="{Binding MoveUpCommand}"
                                                            SemanticProperties.Description="Move selected field left"
                                                            Style="{StaticResource SecondaryPillButtonStyle}" />
                                                    <Button Grid.Column="1" Text="Right" Command="{Binding MoveDownCommand}"
                                                            SemanticProperties.Description="Move selected field right"
                                                            HorizontalOptions="Start"
                                                            Style="{StaticResource SecondaryPillButtonStyle}" />
                                                    <Button Grid.Row="1" Grid.ColumnSpan="2" Text="Reset to Defaults"
                                                            Command="{Binding ResetCommand}" HorizontalOptions="Start"
                                                            Style="{StaticResource SecondaryPillButtonStyle}" />
                                                    <Button Grid.Row="2" Grid.ColumnSpan="2" Text="Apply"
                                                            Command="{Binding ApplyCommand}" HorizontalOptions="Start"
                                                            Style="{StaticResource PillButtonStyle}" />
                                                </Grid>
                                            </VerticalStackLayout>
                                            <Label Text="{Binding Status}" FontSize="12" LineBreakMode="WordWrap" />
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </controls:DeferredContentView.ContentTemplate>
                            </controls:DeferredContentView>
                        </VerticalStackLayout>
                    </Border>

                    <!-- AUDIO FILTERS CARD -->
                    <Border Style="{StaticResource SettingsCardStyle}">

    <VerticalStackLayout Style="{StaticResource SettingsCardContentStyle}">

        <!-- Header -->
        <Grid Style="{StaticResource SettingsCardHeaderStyle}" x:Name="AudioFiltersHeaderGrid" ColumnDefinitions="*,Auto">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnAudioFiltersHeaderTapped" />
            </Grid.GestureRecognizers>

            <Label Style="{StaticResource SettingsCardTitleStyle}"
                Grid.Column="0"
                Text="Audio filters" />

            <Label
                x:Name="AudioFiltersChevronLabel"
                Style="{StaticResource SettingsCardChevronStyle}"
                Grid.Column="1"
                Text="▶" />
        </Grid>

        <!-- Body -->
        <controls:DeferredContentView x:Name="AudioFiltersBodyLayout" IsVisible="False">
            <controls:DeferredContentView.ContentTemplate>
                <DataTemplate x:DataType="vm:SettingsViewModel">
                    <VerticalStackLayout Spacing="10">
            <Label
                Text="Reduce static and quiet emergency tones during playback."
                FontSize="12"
                Opacity="0.8"
                TextColor="{AppThemeBinding Light=#4b5563, Dark=#d1d5db}" />

                        <Label
                Text="Note: Static filter and tone detection are in beta and can consume cpu/battery resources, especially on older devices."
                FontSize="11"
                TextColor="{AppThemeBinding Light=#b91c1c, Dark=#f87171}" />

<Label
                Text="Static filter"
                FontSize="13"
                FontAttributes="Bold"
                Margin="0,4,0,0"
                TextColor="{AppThemeBinding Light=#111827, Dark=#e5e7eb}" />

            <Grid
                RowDefinitions="Auto,Auto"
                ColumnDefinitions="*,120"
                RowSpacing="8"
                ColumnSpacing="12"
                Margin="0,2,0,6">

                <Label
                    Grid.Row="0"
                    Grid.Column="0"
                    Text="Enable static filter"
                    FontSize="12"
                    LineBreakMode="WordWrap"
                    VerticalOptions="Center"
                    HorizontalOptions="Fill" />

                <controls:CompactToggleSwitch
                    Grid.Row="0"
                    Grid.Column="1"
                    IsToggled="{Binding AudioStaticFilterEnabled}"
                    Style="{StaticResource CompactToggleStyle}" />

                <VerticalStackLayout
                    Grid.Row="1"
                    Grid.Column="0"
                    Spacing="2">
                    <Label
                        Text="Static attenuator"
                        FontSize="14"
                        TextColor="{AppThemeBinding Light=#111827, Dark=#e5e7eb}" />
                    <Label
                        Text="Volume controls how much to reduce when static is detected. 0 disables attenuation."
                        FontSize="11"
                        Opacity="0.8"
                        LineBreakMode="WordWrap"
                        TextColor="{AppThemeBinding Light=#111827, Dark=#e5e7eb}" />
                </VerticalStackLayout>

                <Entry
                    Grid.Row="1"
                    Grid.Column="1"
                    Text="{Binding AudioStaticAttenuatorVolume}"
                    IsEnabled="{Binding AudioStaticFilterEnabled}"
                    Keyboard="Numeric"
                    HorizontalTextAlignment="End"
                    ClearButtonVisibility="WhileEditing"
                    TextColor="{AppThemeBinding Light=#111827, Dark=#e5e7eb}"
                    BackgroundColor="{AppThemeBinding Light=#ffffff, Dark=#111827}" />

            </Grid>

            <Label
                Text="Tone detection"
                FontSize="13"
                FontAttributes="Bold"
                Margin="0,4,0,0"
                TextColor="{AppThemeBinding Light=#111827, Dark=#e5e7eb}" />

            <Grid
                RowDefinitions="Auto,Auto,Auto,Auto"
                ColumnDefinitions="*,120"
                RowSpacing="8"
                ColumnSpacing="12"
                Margin="0,2,0,2">

                <Label
                    Grid.Row="0"
                    Grid.Column="0"
                    Text="Enable tone detection"
                    FontSize="12"
                    LineBreakMode="WordWrap"
                    VerticalOptions="Center"
                    HorizontalOptions="Fill" />

                <controls:CompactToggleSwitch
                    Grid.Row="0"
                    Grid.Column="1"
                    IsToggled="{Binding AudioToneFilterEnabled}"
                    Style="{StaticResource CompactToggleStyle}" />

                <VerticalStackLayout
                    Grid.Row="1"
                    Grid.Column="0"
                    Spacing="2">
                    <Label
                        Text="Tone attenuation"
                        FontSize="14"
                        TextColor="{AppThemeBinding Light=#111827, Dark=#e5e7eb}" />
                    <Label
                        Text="How much the tones are reduced."
                        FontSize="11"
                        Opacity="0.8"
                        LineBreakMode="WordWrap"
                        TextColor="{AppThemeBinding Light=#111827, Dark=#e5e7eb}" />
                </VerticalStackLayout>

                <Entry
                    Grid.Row="1"
                    Grid.Column="1"
                    Text="{Binding AudioToneStrength}"
                    IsEnabled="{Binding AudioToneFilterEnabled}"
                    Keyboard="Numeric"
                    HorizontalTextAlignment="End"
                    ClearButtonVisibility="WhileEditing"
                    TextColor="{AppThemeBinding Light=#111827, Dark=#e5e7eb}"
                    BackgroundColor="{AppThemeBinding Light=#ffffff, Dark=#111827}" />

                <VerticalStackLayout
                    Grid.Row="2"
                    Grid.Column="0"
                    Spacing="2">
                    <Label
                        Text="Detection sensitivity"
                        FontSize="14"
                        TextColor="{AppThemeBinding Light=#111827, Dark=#e5e7eb}" />
                    <Label
                        Text="Higher detects tones more easily. Lower reduces false positives."
                        FontSize="11"
                        Opacity="0.8"
                        LineBreakMode="WordWrap"
                        TextColor="{AppThemeBinding Light=#111827, Dark=#e5e7eb}" />
                </VerticalStackLayout>

                <Grid
                    Grid.Row="2"
                    Grid.Column="1"
                    RowDefinitions="Auto,Auto"
                    ColumnDefinitions="*"
                    RowSpacing="4"
                    IsEnabled="{Binding AudioToneFilterEnabled}">

                    <Label
                        Grid.Row="0"
                        Text="{Binding AudioToneSensitivity}"
                        FontSize="12"
                        HorizontalTextAlignment="End"
                        TextColor="{AppThemeBinding Light=#111827, Dark=#e5e7eb}" />

                    <Slider
                        Grid.Row="1"
                        Minimum="0"
                        Maximum="100"
                        Value="{Binding AudioToneSensitivity}"
                        MinimumTrackColor="{AppThemeBinding Light=#111827, Dark=#e5e7eb}"
                        MaximumTrackColor="{AppThemeBinding Light=#e5e7eb, Dark=#374151}" />
                </Grid>

                <VerticalStackLayout
                    Grid.Row="3"
                    Grid.Column="0"
                    Spacing="2">
                    <Label
                        Text="Alert length (minutes)"
                        FontSize="14"
                        TextColor="{AppThemeBinding Light=#111827, Dark=#e5e7eb}" />
                    <Label
                        Text="How long the talkgroup stays highlighted after a tone-only call."
                        FontSize="11"
                        Opacity="0.8"
                        LineBreakMode="WordWrap"
                        TextColor="{AppThemeBinding Light=#111827, Dark=#e5e7eb}" />
                </VerticalStackLayout>

                <Entry
                    Grid.Row="3"
                    Grid.Column="1"
                    Text="{Binding AudioToneHighlightMinutes}"
                    IsEnabled="{Binding AudioToneFilterEnabled}"
                    Keyboard="Numeric"
                    HorizontalTextAlignment="End"
                    ClearButtonVisibility="WhileEditing"
                    TextColor="{AppThemeBinding Light=#111827, Dark=#e5e7eb}"
                    BackgroundColor="{AppThemeBinding Light=#ffffff, Dark=#111827}" />
            </Grid>

            <Label
                Text="Tone-only detections will highlight matching talkgroups for the configured alert length."
                FontSize="11"
                Opacity="0.75"
                TextColor="{AppThemeBinding Light=#4b5563, Dark=#d1d5db}" />
                    </VerticalStackLayout>
                </DataTemplate>
            </controls:DeferredContentView.ContentTemplate>
        </controls:DeferredContentView>

    </VerticalStackLayout>

</Border>


                    <!-- AUDIO OPTIONS CARD -->
                    <Border Style="{StaticResource SettingsCardStyle}">

    <VerticalStackLayout Style="{StaticResource SettingsCardContentStyle}">

        <Grid Style="{StaticResource SettingsCardHeaderStyle}" x:Name="AudioHeaderGrid" ColumnDefinitions="*,Auto">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnAudioHeaderTapped" />
            </Grid.GestureRecognizers>

            <Label Style="{StaticResource SettingsCardTitleStyle}"
                Grid.Column="0"
                Text="Audio options" />

            <Label
                x:Name="AudioChevronLabel"
                Style="{StaticResource SettingsCardChevronStyle}"
                Grid.Column="1"
                Text="▶" />
        </Grid>

        <controls:DeferredContentView x:Name="AudioBodyLayout" IsVisible="False">
            <controls:DeferredContentView.ContentTemplate>
                <DataTemplate x:DataType="vm:SettingsViewModel">
                    <VerticalStackLayout Spacing="8" Margin="0,0,0,4">
                        <Label Text="Automatic Playback Source" FontSize="12" />
                        <Picker SelectedIndex="{Binding LivePlaybackSourceModeIndex, Mode=TwoWay}"
                                AutomationId="AutomaticPlaybackSource" SemanticProperties.Description="Automatic playback source">
                            <Picker.Items>
                                <x:String>All Enabled Servers</x:String>
                                <x:String>Selected Server / Favorites Only</x:String>
                            </Picker.Items>
                        </Picker>
                        <Label Text="Audio Cache Size" FontSize="12" />
                        <Picker SelectedIndex="{Binding AudioCacheLimitIndex, Mode=TwoWay}"
                                AutomationId="AudioCacheSize" SemanticProperties.Description="Audio cache size">
                            <Picker.Items>
                                <x:String>25 MB</x:String>
                                <x:String>50 MB</x:String>
                                <x:String>100 MB</x:String>
                                <x:String>250 MB</x:String>
                                <x:String>500 MB</x:String>
                                <x:String>1 GB</x:String>
                            </Picker.Items>
                        </Picker>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Label Text="Current Cache Usage" FontSize="12" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="{Binding AudioCacheUsage}" FontSize="12"
                                   VerticalOptions="Center" AutomationId="AudioCacheUsage" />
                        </Grid>
                        <Button Text="Clear Audio Cache" Command="{Binding ClearAudioCacheCommand}"
                                AutomationId="ClearAudioCache" HorizontalOptions="Start" />
                        <Label Text="{Binding AudioCacheError}" IsVisible="{Binding HasAudioCacheError}" FontSize="12" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Label Text="Group calls by talkgroup" FontSize="12" VerticalOptions="Center" />
                            <Switch Grid.Column="1" AutomationId="GroupLiveCalls" IsToggled="{Binding GroupLiveCalls, Mode=TwoWay}"
                                    SemanticProperties.Description="Group calls by talkgroup" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Label Text="Prioritize favorite talkgroups" FontSize="12" VerticalOptions="Center" />
                            <Switch Grid.Column="1" AutomationId="PrioritizeLiveFavorites" IsToggled="{Binding PrioritizeLiveFavorites, Mode=TwoWay}"
                                    SemanticProperties.Description="Prioritize favorite talkgroups" />
                        </Grid>
                        <Label Text="Maximum consecutive calls per talkgroup" FontSize="12" />
                        <Picker SelectedIndex="{Binding ConsecutiveLiveCallLimitIndex, Mode=TwoWay}"
                                AutomationId="ConsecutiveLiveCallLimit" SemanticProperties.Description="Maximum consecutive calls per talkgroup">
                            <Picker.Items>
                                <x:String>1</x:String>
                                <x:String>2</x:String>
                                <x:String>3</x:String>
                                <x:String>4</x:String>
                                <x:String>5</x:String>
                                <x:String>6</x:String>
                                <x:String>7</x:String>
                                <x:String>8</x:String>
                                <x:String>9</x:String>
                                <x:String>10</x:String>
                            </Picker.Items>
                        </Picker>
                        <Grid ColumnDefinitions="*,105" ColumnSpacing="8">
                            <Label Text="Backlog warning (ready calls)" FontSize="12" VerticalOptions="Center" />
                            <Entry Grid.Column="1" Keyboard="Numeric" AutomationId="LiveBacklogWarningThreshold"
                                   Text="{Binding LiveBacklogWarningThreshold, Mode=TwoWay, UpdateSourceEventName=Unfocused}"
                                   SemanticProperties.Description="Backlog warning threshold in ready calls" />
                        </Grid>
                        <Grid ColumnDefinitions="*,105" ColumnSpacing="8">
                            <Label Text="Automatic Jump (ready calls)" FontSize="12" VerticalOptions="Center" />
                            <Entry Grid.Column="1" Keyboard="Numeric" AutomationId="LiveBacklogJumpThreshold"
                                   Text="{Binding LiveBacklogJumpThreshold, Mode=TwoWay, UpdateSourceEventName=Unfocused}"
                                   SemanticProperties.Description="Automatic Jump threshold in ready calls" />
                        </Grid>
                        <Label Text="Verified Playback Lag Recovery" FontSize="12" />
                        <Picker ItemsSource="{Binding VerifiedLagOptions}"
                                SelectedIndex="{Binding VerifiedLagOptionIndex, Mode=TwoWay}"
                                AutomationId="VerifiedPlaybackLagRecovery" SemanticProperties.Description="Verified Playback Lag Recovery" />
                        <Grid IsVisible="{Binding ShowsCustomVerifiedLagMinutes}" ColumnDefinitions="*,105" ColumnSpacing="8">
                            <Label Text="Custom threshold (minutes)" FontSize="12" VerticalOptions="Center" />
                            <Entry Grid.Column="1" Keyboard="Numeric" MaxLength="4" AutomationId="CustomVerifiedLagMinutes"
                                   Text="{Binding CustomVerifiedLagMinutes, Mode=TwoWay, UpdateSourceEventName=Unfocused}"
                                   SemanticProperties.Description="Custom verified playback lag in minutes, 1 to 1440" />
                        </Grid>
                        <Label IsVisible="{Binding HasLivePlaybackSettingsError}" Text="{Binding LivePlaybackSettingsError}"
                               FontSize="12" TextColor="{AppThemeBinding Light=#b91c1c, Dark=#fca5a5}" />
                        <VerticalStackLayout Spacing="8" IsVisible="{OnPlatform Android=true, iOS=true, Default=false}">
                        <Label Text="Mobile audio mode" FontSize="12"
                               TextColor="{AppThemeBinding Light=#111827, Dark=#e5e7eb}" />
                        <Picker SelectedIndex="{Binding MobileAudioModeIndex, Mode=TwoWay}"
                                SemanticProperties.Description="Mobile audio mode">
                            <Picker.Items>
                                <x:String>Mix normally</x:String>
                                <x:String>Mix and duck</x:String>
                                <x:String>Exclusive</x:String>
                            </Picker.Items>
                        </Picker>

                        <Label Text="When headphones or Bluetooth disconnect" FontSize="12" LineBreakMode="WordWrap"
                               TextColor="{AppThemeBinding Light=#111827, Dark=#e5e7eb}" />
                        <Picker SelectedIndex="{Binding AudioDisconnectionIndex, Mode=TwoWay}"
                                SemanticProperties.Description="When headphones or Bluetooth disconnect">
                            <Picker.Items>
                                <x:String>Pause playback</x:String>
                                <x:String>Continue through phone speaker</x:String>
                            </Picker.Items>
                        </Picker>
                        </VerticalStackLayout>
                        <Label Text="Return to Live after interruption" FontSize="12"
                               TextColor="{AppThemeBinding Light=#111827, Dark=#e5e7eb}" />
                        <Picker SelectedIndex="{Binding InterruptionRecoveryIndex, Mode=TwoWay}"
                                SemanticProperties.Description="Return to Live after interruption">
                            <Picker.Items>
                                <x:String>Immediately</x:String>
                                <x:String>1 minute</x:String>
                                <x:String>2 minutes</x:String>
                                <x:String>5 minutes</x:String>
                                <x:String>10 minutes</x:String>
                                <x:String>15 minutes</x:String>
                                <x:String>30 minutes</x:String>
                                <x:String>60 minutes</x:String>
                                <x:String>Custom duration</x:String>
                                <x:String>Never (resume queued recordings)</x:String>
                            </Picker.Items>
                        </Picker>
                        <VerticalStackLayout Spacing="4" IsVisible="{Binding ShowsCustomRecoveryMinutes}">
                            <Entry Text="{Binding CustomRecoveryMinutes, Mode=TwoWay}" Keyboard="Numeric" MaxLength="4"
                                   Placeholder="Minutes" SemanticProperties.Description="Custom interruption duration in minutes" />
                            <Label Text="Enter a whole number from 1 to 1,440 minutes." FontSize="12"
                                   IsVisible="{Binding HasInvalidCustomRecoveryMinutes}"
                                   TextColor="{AppThemeBinding Light=#b91c1c, Dark=#fca5a5}" />
                        </VerticalStackLayout>
                        <Label IsVisible="{Binding HasMobileAudioSaveError}" FontSize="12"
                               Text="Audio preferences were not saved. Playback is still using the last saved options."
                               TextColor="{AppThemeBinding Light=#b91c1c, Dark=#fca5a5}" />
                        <Button IsVisible="{Binding HasMobileAudioSaveError}" Text="Retry save"
                                HorizontalOptions="Start" Command="{Binding SaveCommand}" />
                    </VerticalStackLayout>
                </DataTemplate>
            </controls:DeferredContentView.ContentTemplate>
        </controls:DeferredContentView>

    </VerticalStackLayout>

</Border>

                    <!-- ADDRESS DETECTION CARD -->
                    <Border Style="{StaticResource SettingsCardStyle}">

    <VerticalStackLayout Style="{StaticResource SettingsCardContentStyle}">

        <!-- Header -->
        <Grid Style="{StaticResource SettingsCardHeaderStyle}" x:Name="AddressDetectionHeaderGrid" ColumnDefinitions="*,Auto">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnAddressDetectionHeaderTapped" />
            </Grid.GestureRecognizers>

            <Label Style="{StaticResource SettingsCardTitleStyle}"
                Grid.Column="0"
                Text="Address detection" />

            <Label
                x:Name="AddressDetectionChevronLabel"
                Style="{StaticResource SettingsCardChevronStyle}"
                Grid.Column="1"
                Text="▶" />
        </Grid>

        <!-- Body -->
        <controls:DeferredContentView x:Name="AddressDetectionBodyLayout" IsVisible="False">
            <controls:DeferredContentView.ContentTemplate>
                <DataTemplate x:DataType="vm:SettingsViewModel">
                    <VerticalStackLayout Spacing="10">
            <Label
                Text="Detects addresses in transcriptions and can open them in maps."
                FontSize="12"
                Opacity="0.8"
                TextColor="{AppThemeBinding Light=#4b5563, Dark=#d1d5db}" />

            <Label
                Text="Note: Address detection is in beta and can consume cpu/battery resources."
                FontSize="11"
                TextColor="{AppThemeBinding Light=#b91c1c, Dark=#f87171}" />

            <Grid
                RowDefinitions="Auto,Auto,Auto,Auto"
                ColumnDefinitions="*,Auto"
                RowSpacing="8"
                ColumnSpacing="12"
                Margin="0,4,0,6">

                
                

                <Label
                    Grid.Row="0"
                    Grid.Column="0"
                    Text="Enable address detection"
                    FontSize="12"
                    LineBreakMode="WordWrap"
                    VerticalOptions="Center"
                    HorizontalOptions="Fill" />

                <controls:CompactToggleSwitch
                    Grid.Row="0"
                    Grid.Column="1"
                    IsToggled="{Binding AddressDetectionEnabled}"
                    Style="{StaticResource CompactToggleStyle}" />

                <Label
                    Grid.Row="1"
                    Grid.Column="0"
                    Text="Open maps when address is tapped"
                    FontSize="12"
                    LineBreakMode="WordWrap"
                    VerticalOptions="Center"
                    HorizontalOptions="Fill" />

                <controls:CompactToggleSwitch
                    Grid.Row="1"
                    Grid.Column="1"
                    IsToggled="{Binding AddressDetectionOpenMapsOnTap}"
                    IsEnabled="{Binding AddressDetectionEnabled}"
                    Style="{StaticResource CompactToggleStyle}" />

                <Label
                    Grid.Row="2"
                    Grid.Column="0"
                    Text="Show what3words links"
                    FontSize="12"
                    LineBreakMode="WordWrap"
                    VerticalOptions="Center"
                    HorizontalOptions="Fill" />

                <controls:CompactToggleSwitch
                    Grid.Row="2"
                    Grid.Column="1"
                    IsToggled="{Binding What3WordsLinksEnabled}"
                    Style="{StaticResource CompactToggleStyle}" />

                <VerticalStackLayout
                    Grid.Row="3"
                    Grid.Column="0"
                    Grid.ColumnSpan="1"
                    Spacing="4">

                    <Label
                        Text="what3words API key (optional)"
                        FontSize="12"
                        Opacity="0.85"
                        TextColor="{AppThemeBinding Light=#111827, Dark=#e5e7eb}" />

                    <Entry
                        Text="{Binding What3WordsApiKey}"
                        IsPassword="True"
                        Placeholder="Leave blank to skip API calls"
                        FontSize="12"
                        HeightRequest="36"
                        TextColor="{AppThemeBinding Light=Black, Dark=White}"
                        PlaceholderColor="{AppThemeBinding Light=#6b7280, Dark=#9ca3af}"
                        BackgroundColor="{AppThemeBinding Light=White, Dark=#111827}" />


                    <Label
                        Text="If provided, the app will resolve detected ///word.word.word to latitude and longitude so it can be shown and copied on the call card. If left blank, the what3words link still works and opens the what3words map."
                        FontSize="11"
                        LineBreakMode="WordWrap"
                        Opacity="0.75"
                        TextColor="{AppThemeBinding Light=#111827, Dark=#e5e7eb}" />

                </VerticalStackLayout>


            </Grid>

<Label
                Text="Tunings"
                FontSize="13"
                FontAttributes="Bold"
                Margin="0,6,0,0"
                TextColor="{AppThemeBinding Light=#111827, Dark=#e5e7eb}" />

            <Grid ColumnDefinitions="*,120" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10" ColumnSpacing="12">

                <VerticalStackLayout
                    Grid.Row="0"
                    Grid.Column="0"
                    Spacing="2">

                    <Label
                        Text="Minimum confidence percent"
                        FontSize="14"
                        TextColor="{AppThemeBinding Light=#111827, Dark=#e5e7eb}" />

                    <Label
                        Text="Higher values reduce false positives but may miss partial addresses."
                        FontSize="11"
                        Opacity="0.8"
                        LineBreakMode="WordWrap"
                        TextColor="{AppThemeBinding Light=#111827, Dark=#e5e7eb}" />
                </VerticalStackLayout>
                <Entry
                    Grid.Row="0"
                    Grid.Column="1"
                    Text="{Binding AddressDetectionMinConfidencePercent}"
                    Keyboard="Numeric"
                    HorizontalTextAlignment="End"
                    ClearButtonVisibility="WhileEditing"
                    TextColor="{AppThemeBinding Light=#111827, Dark=#e5e7eb}"
                    BackgroundColor="{AppThemeBinding Light=#ffffff, Dark=#111827}" />

                <VerticalStackLayout
                    Grid.Row="1"
                    Grid.Column="0"
                    Spacing="2">

                    <Label
                        Text="Minimum address characters"
                        FontSize="14"
                        TextColor="{AppThemeBinding Light=#111827, Dark=#e5e7eb}" />

                    <Label
                        Text="Minimum length of an extracted address string before it is considered."
                        FontSize="11"
                        Opacity="0.8"
                        LineBreakMode="WordWrap"
                        TextColor="{AppThemeBinding Light=#111827, Dark=#e5e7eb}" />
                </VerticalStackLayout>
                <Entry
                    Grid.Row="1"
                    Grid.Column="1"
                    Text="{Binding AddressDetectionMinAddressChars}"
                    Keyboard="Numeric"
                    HorizontalTextAlignment="End"
                    ClearButtonVisibility="WhileEditing"
                    TextColor="{AppThemeBinding Light=#111827, Dark=#e5e7eb}"
                    BackgroundColor="{AppThemeBinding Light=#ffffff, Dark=#111827}" />

                <VerticalStackLayout
                    Grid.Row="2"
                    Grid.Column="0"
                    Spacing="2">

                    <Label
                        Text="Max candidates per call"
                        FontSize="14"
                        TextColor="{AppThemeBinding Light=#111827, Dark=#e5e7eb}" />

                    <Label
                        Text="Limits how many possible addresses are kept per call transcript."
                        FontSize="11"
                        Opacity="0.8"
                        LineBreakMode="WordWrap"
                        TextColor="{AppThemeBinding Light=#111827, Dark=#e5e7eb}" />
                </VerticalStackLayout>
                <Entry
                    Grid.Row="2"
                    Grid.Column="1"
                    Text="{Binding AddressDetectionMaxCandidatesPerCall}"
                    Keyboard="Numeric"
                    HorizontalTextAlignment="End"
                    ClearButtonVisibility="WhileEditing"
                    TextColor="{AppThemeBinding Light=#111827, Dark=#e5e7eb}"
                    BackgroundColor="{AppThemeBinding Light=#ffffff, Dark=#111827}" />


            </Grid>

            <Label
                Text="Address Detection runs locally on calls as they arrive and when transcriptions update. When enabled, detected addresses can be tapped to open your maps app if you choose."
                FontSize="11"
                Opacity="0.75"
                TextColor="{AppThemeBinding Light=#4b5563, Dark=#d1d5db}" />
                    </VerticalStackLayout>
                </DataTemplate>
            </controls:DeferredContentView.ContentTemplate>
        </controls:DeferredContentView>

    </VerticalStackLayout>

</Border>

<!-- BLUETOOTH LABELS CARD -->
                    <Border Style="{StaticResource SettingsCardStyle}">

    <VerticalStackLayout Style="{StaticResource SettingsCardContentStyle}">

        <!-- Header -->
        <Grid Style="{StaticResource SettingsCardHeaderStyle}" x:Name="BluetoothHeaderGrid" ColumnDefinitions="*,Auto">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnBluetoothHeaderTapped" />
            </Grid.GestureRecognizers>

            <Label Style="{StaticResource SettingsCardTitleStyle}"
                Grid.Column="0"
                Text="Bluetooth options" />

            <Label
                x:Name="BluetoothChevronLabel"
                Style="{StaticResource SettingsCardChevronStyle}"
                Grid.Column="1"
                Text="▶" />
        </Grid>

        <!-- Body -->
        <controls:DeferredContentView x:Name="BluetoothBodyLayout" IsVisible="False">
            <controls:DeferredContentView.ContentTemplate>
                <DataTemplate x:DataType="vm:SettingsViewModel">
                    <VerticalStackLayout Spacing="6">
            <Label
                Text="Choose which call fields show up on your Bluetooth device. Not all devices display all fields."
                FontSize="12"
                Margin="0,0,0,2"
                Opacity="0.8"
                TextColor="{AppThemeBinding Light=#4b5563, Dark=#d1d5db}" />

            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                                              ColumnDefinitions="Auto,*"
                                              RowSpacing="4"
                                              ColumnSpacing="10">

                                            <Label Grid.Row="0" Text="Artist" FontSize="12" VerticalOptions="Center" TextColor="{AppThemeBinding Light=#111827, Dark=#e5e7eb}" />
                                            <Picker Grid.Row="0" Grid.Column="1"
                                                    ItemsSource="{Binding BluetoothLabelOptions}"
                                                    SelectedItem="{Binding BluetoothLabelArtistOption}"
                                                    ItemDisplayBinding="{Binding Label}"
                                                    FontSize="13"
                                                    HorizontalOptions="FillAndExpand"
                                                    VerticalOptions="Center" />

                                            <Label Grid.Row="1" Text="Title" FontSize="12" VerticalOptions="Center" TextColor="{AppThemeBinding Light=#111827, Dark=#e5e7eb}" />
                                            <Picker Grid.Row="1" Grid.Column="1"
                                                    ItemsSource="{Binding BluetoothLabelOptions}"
                                                    SelectedItem="{Binding BluetoothLabelTitleOption}"
                                                    ItemDisplayBinding="{Binding Label}"
                                                    FontSize="13"
                                                    HorizontalOptions="FillAndExpand"
                                                    VerticalOptions="Center" />

                                            <Label Grid.Row="2" Text="Album" FontSize="12" VerticalOptions="Center" TextColor="{AppThemeBinding Light=#111827, Dark=#e5e7eb}" />
                                            <Picker Grid.Row="2" Grid.Column="1"
                                                    ItemsSource="{Binding BluetoothLabelOptions}"
                                                    SelectedItem="{Binding BluetoothLabelAlbumOption}"
                                                    ItemDisplayBinding="{Binding Label}"
                                                    FontSize="13"
                                                    HorizontalOptions="FillAndExpand"
                                                    VerticalOptions="Center" />

                                            <Label Grid.Row="3" Text="Composer" FontSize="12" VerticalOptions="Center" TextColor="{AppThemeBinding Light=#111827, Dark=#e5e7eb}" />
                                            <Picker Grid.Row="3" Grid.Column="1"
                                                    ItemsSource="{Binding BluetoothLabelOptions}"
                                                    SelectedItem="{Binding BluetoothLabelComposerOption}"
                                                    ItemDisplayBinding="{Binding Label}"
                                                    FontSize="13"
                                                    HorizontalOptions="FillAndExpand"
                                                    VerticalOptions="Center" />

                                            <Label Grid.Row="4" Text="Genre" FontSize="12" VerticalOptions="Center" TextColor="{AppThemeBinding Light=#111827, Dark=#e5e7eb}" />
                                            <Picker Grid.Row="4" Grid.Column="1"
                                                    ItemsSource="{Binding BluetoothLabelOptions}"
                                                    SelectedItem="{Binding BluetoothLabelGenreOption}"
                                                    ItemDisplayBinding="{Binding Label}"
                                                    FontSize="13"
                                                    HorizontalOptions="FillAndExpand"
                                                    VerticalOptions="Center" />
                                        </Grid>
                    </VerticalStackLayout>
                </DataTemplate>
            </controls:DeferredContentView.ContentTemplate>
        </controls:DeferredContentView>

    </VerticalStackLayout>
</Border>

                    <!-- THEME CARD -->
                    <Border Style="{StaticResource SettingsCardStyle}">

    <VerticalStackLayout Style="{StaticResource SettingsCardContentStyle}">

        <!-- Header -->
        <Grid Style="{StaticResource SettingsCardHeaderStyle}" x:Name="ThemeHeaderGrid" ColumnDefinitions="*,Auto">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnThemeHeaderTapped" />
            </Grid.GestureRecognizers>

            <Label Style="{StaticResource SettingsCardTitleStyle}"
                Grid.Column="0"
                Text="Theme" />

            <Label
                x:Name="ThemeChevronLabel"
                Style="{StaticResource SettingsCardChevronStyle}"
                Grid.Column="1"
                Text="▶" />
        </Grid>

        <!-- Body -->
        <controls:DeferredContentView x:Name="ThemeBodyLayout" IsVisible="False">
            <controls:DeferredContentView.ContentTemplate>
                <DataTemplate x:DataType="vm:SettingsViewModel">
                    <VerticalStackLayout Spacing="10">

            <Label
                                                        Text="Choose System, Light, or Dark."
                                                        FontSize="12"
                                                        Opacity="0.8"
                                                        TextColor="{AppThemeBinding Light=#4b5563, Dark=#d1d5db}" />

                                        <VerticalStackLayout Spacing="6">
                                            <HorizontalStackLayout Spacing="10">
                                                <RadioButton
                                                                Content="System"
                                                                IsChecked="{Binding IsThemeSystem}" />
                                                <RadioButton
                                                                Content="Light"
                                                                IsChecked="{Binding IsThemeLight}" />
                                                <RadioButton
                                                                Content="Dark"
                                                                IsChecked="{Binding IsThemeDark}" />
                                            </HorizontalStackLayout>

            </VerticalStackLayout>
                    </VerticalStackLayout>
                </DataTemplate>
            </controls:DeferredContentView.ContentTemplate>
        </controls:DeferredContentView>
    </VerticalStackLayout>
</Border>


                    <Border Style="{StaticResource SettingsCardStyle}">
                        <VerticalStackLayout Style="{StaticResource SettingsCardContentStyle}">
                            <Grid Style="{StaticResource SettingsCardHeaderStyle}" ColumnDefinitions="*,Auto">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnPrivacyNetworkHeaderTapped" />
                                </Grid.GestureRecognizers>
                                <Label Text="Privacy &amp; Network" Style="{StaticResource SettingsCardTitleStyle}" />
                                <Label x:Name="PrivacyNetworkChevron" Grid.Column="1" Text="▶"
                                       Style="{StaticResource SettingsCardChevronStyle}" />
                            </Grid>
                            <controls:DeferredContentView x:Name="PrivacyNetworkBody" IsVisible="False">
                                <controls:DeferredContentView.ContentTemplate>
                                    <DataTemplate x:DataType="vm:SettingsViewModel">
                                        <VerticalStackLayout Spacing="10">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                <Label Text="Local Only Mode" VerticalOptions="Center" />
                                                <controls:CompactToggleSwitch Grid.Column="1" IsToggled="{Binding LocalOnlyMode, Mode=TwoWay}"
                                                        AutomationId="LocalOnlyMode" Style="{StaticResource CompactToggleStyle}" />
                                            </Grid>
                                            <Label Text="Pauses Joe’s Scanner online services while independent recorders stay available."
                                                   FontSize="12" />
                                            <Label Text="{Binding FavoritesStatus}" FontSize="12" IsVisible="{Binding LocalOnlyMode}" />
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </controls:DeferredContentView.ContentTemplate>
                            </controls:DeferredContentView>
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <VerticalStackLayout Style="{StaticResource SettingsCardContentStyle}">
                            <Grid Style="{StaticResource SettingsCardHeaderStyle}" ColumnDefinitions="*,Auto">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnFavoritesHeaderTapped" />
                                </Grid.GestureRecognizers>
                                <Label Text="Favorites" Style="{StaticResource SettingsCardTitleStyle}" />
                                <Label x:Name="FavoritesChevron" Grid.Column="1" Text="▶"
                                       Style="{StaticResource SettingsCardChevronStyle}" />
                            </Grid>
                            <controls:DeferredContentView x:Name="FavoritesBodyLayout" IsVisible="False">
                                <controls:DeferredContentView.ContentTemplate>
                                    <DataTemplate x:DataType="vm:SettingsViewModel">
                                        <VerticalStackLayout Spacing="8">
                                            <Label Text="{Binding FavoritesStatus}" FontSize="12" />
                                            <Grid ColumnDefinitions="*,*" ColumnSpacing="6" RowDefinitions="Auto,Auto" RowSpacing="6">
                                                <Button Text="Manage Favorites" Clicked="OnManageFavoritesClicked"
                                                        AutomationId="ManageSavedFavorites" />
                                                <Button Grid.Column="1" Text="Manage groups" Clicked="OnManageFavoriteGroupsClicked"
                                                        AutomationId="ManageFavoriteGroups" />
                                                <Button Grid.Row="1" Text="Link custom recorders" Clicked="OnLinkFavoriteRecorderClicked" />
                                                <Button Grid.Row="1" Grid.Column="1" Text="Resolve sync conflicts"
                                                        IsVisible="{Binding FavoritesHasConflicts}" Clicked="OnResolveFavoriteConflictClicked" />
                                            </Grid>
                                            <VerticalStackLayout Spacing="4" IsVisible="{Binding FavoritesCanSignIn}">
                                                <Entry x:Name="FavoritesAccountName" Placeholder="Joe’s Scanner username or email"
                                                       AutomationId="FavoritesAccountName" IsSpellCheckEnabled="False" />
                                                <controls:CursorHidingEntry x:Name="FavoritesAccountPassword" Placeholder="Password"
                                                       AutomationId="FavoritesAccountPassword" IsPassword="True" />
                                                <Button Text="Sign in" Clicked="OnFavoritesSignInClicked" HorizontalOptions="Start" />
                                            </VerticalStackLayout>
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" IsVisible="{Binding FavoritesCanSignOut}">
                                                <Button Text="Import device Favorites" Clicked="OnImportDeviceFavoritesClicked" />
                                                <Button Grid.Column="1" Text="Sign out" Clicked="OnFavoritesSignOutClicked" />
                                            </Grid>
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </controls:DeferredContentView.ContentTemplate>
                            </controls:DeferredContentView>
                        </VerticalStackLayout>
                    </Border>

                    <!-- LOG CARD -->
                    <Border Style="{StaticResource SettingsCardStyle}">

    <VerticalStackLayout Style="{StaticResource SettingsCardContentStyle}">

        <!-- Header -->
        <Grid Style="{StaticResource SettingsCardHeaderStyle}" x:Name="LogHeaderGrid" ColumnDefinitions="*,Auto">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnLogHeaderTapped" />
            </Grid.GestureRecognizers>

            <Label Style="{StaticResource SettingsCardTitleStyle}"
                Grid.Column="0"
                Text="Log" />

            <Label
                x:Name="LogChevronLabel"
                Style="{StaticResource SettingsCardChevronStyle}"
                Grid.Column="1"
                Text="▶" />
        </Grid>

        <!-- Body -->
        <controls:DeferredContentView x:Name="LogBodyLayout" IsVisible="False">
            <controls:DeferredContentView.ContentTemplate>
                <DataTemplate x:DataType="vm:SettingsViewModel">
                    <VerticalStackLayout Spacing="10">

            <Label
                Text="Recent log entries. Use Refresh, Copy, or Download to export."
                FontSize="12"
                Opacity="0.8"
                TextColor="{AppThemeBinding Light=#4b5563, Dark=#d1d5db}" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                <Label
                    Text="Enable logging"
                    FontSize="12"
                    VerticalOptions="Center"
                    TextColor="{AppThemeBinding Light=#111827, Dark=#e5e7eb}" />

                <controls:CompactToggleSwitch
                    x:Name="LogEnabledToggle"
                    Grid.Column="1"
                    IsToggled="{Binding LogEnabled, Mode=TwoWay}"
                    Style="{StaticResource CompactToggleStyle}" />
            </Grid>


            <corecontrols:SelectableEditor
                x:Name="LogEditor"
                Text=""
                IsReadOnly="True"
                FontSize="12"
                HeightRequest="220"
                AutoSize="Disabled"
                TextColor="{AppThemeBinding Light=#111827, Dark=#e5e7eb}"
                BackgroundColor="{AppThemeBinding Light=#f3f4f6, Dark=#0b1220}" />

            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="10">
                <Button
                    Text="Refresh"
                    Clicked="OnRefreshLogClicked"
                    Style="{StaticResource SecondaryPillButtonStyle}" />

                <Button
                    Grid.Column="1"
                    Text="Clear"
                    Clicked="OnClearLogClicked"
                    Style="{StaticResource SecondaryPillButtonStyle}" />

                <Button
                    Grid.Column="2"
                    Text="Copy"
                    Clicked="OnCopyLogClicked"
                    Style="{StaticResource SecondaryPillButtonStyle}" />

                <Button
                    Grid.Column="3"
                    Text="Download"
                    Clicked="OnDownloadLogClicked"
                    Style="{StaticResource PillButtonStyle}" />
            </Grid>
                    </VerticalStackLayout>
                </DataTemplate>
            </controls:DeferredContentView.ContentTemplate>
        </controls:DeferredContentView>

    </VerticalStackLayout>
</Border>

                    <!-- ABOUT CARD -->
                    <Border Style="{StaticResource SettingsCardStyle}">

    <VerticalStackLayout Style="{StaticResource SettingsCardContentStyle}">

        <Grid Style="{StaticResource SettingsCardHeaderStyle}">
            <Label Text="About" Style="{StaticResource SettingsCardTitleStyle}" />
        </Grid>

        <Label
            Text="App info, support, and update actions for this device."
            FontSize="12"
            Opacity="0.8"
            TextColor="{AppThemeBinding Light=#4b5563, Dark=#d1d5db}" />

        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="8">
            <Label Grid.Row="0" Text="App" FontSize="12" FontAttributes="Bold" VerticalOptions="Center" />
            <Label Grid.Row="0" Grid.Column="1" Text="Joe's Scanner" FontSize="12" VerticalOptions="Center" />

            <Label Grid.Row="1" Text="Version" FontSize="12" FontAttributes="Bold" VerticalOptions="Center" />
            <Label x:Name="AboutVersionLabel" Grid.Row="1" Grid.Column="1" Text="" FontSize="12" VerticalOptions="Center" />

            <Label Grid.Row="2" Text="Platform" FontSize="12" FontAttributes="Bold" VerticalOptions="Center" />
            <Label x:Name="AboutPlatformLabel" Grid.Row="2" Grid.Column="1" Text="" FontSize="12" VerticalOptions="Center" />

            <Label Grid.Row="3" Text="Store" FontSize="12" FontAttributes="Bold" VerticalOptions="Center" />
            <Label x:Name="AboutStoreLabel" Grid.Row="3" Grid.Column="1" Text="" FontSize="12" VerticalOptions="Center" />
        </Grid>

        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="6" RowSpacing="6">
            <Button Grid.Row="0" Grid.Column="0" HorizontalOptions="Start"
                Text="Check for updates"
                Clicked="OnCheckForUpdatesClicked"
                Style="{StaticResource PillButtonStyle}" />

            <Button Grid.Row="0" Grid.Column="1" HorizontalOptions="Start"
                Text="Store page"
                Clicked="OnOpenStorePageClicked"
                Style="{StaticResource SecondaryPillButtonStyle}" />

            <Button Grid.Row="1" Grid.Column="0" HorizontalOptions="Start"
                Text="Support"
                Clicked="OnOpenSupportSiteClicked"
                Style="{StaticResource SecondaryPillButtonStyle}" />

            <Button Grid.Row="1" Grid.Column="1" HorizontalOptions="Start"
                Text="Privacy Policy"
                Clicked="OnOpenPrivacyPolicyClicked"
                Style="{StaticResource SecondaryPillButtonStyle}" />
        </Grid>

    </VerticalStackLayout>
</Border>

                </VerticalStackLayout>
            </Border>
        </ScrollView>

    </controls:SettingsLayoutGrid>
</ContentPage>
