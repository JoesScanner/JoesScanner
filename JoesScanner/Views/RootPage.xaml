<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="JoesScanner.Views.RootPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:JoesScanner.Views.Controls"
    BackgroundColor="{StaticResource TabStripNavy}"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False">

    <Grid
        Padding="5,0,5,5"
        RowDefinitions="Auto,*"
        RowSpacing="0">

        <controls:AppTabStrip
            x:Name="TabStrip"
            Grid.Row="0" />

        <Grid Grid.Row="1">

            <Grid
                x:Name="ContentHost" />

            <Grid
                x:Name="NavigationFeedbackOverlay"
                IsVisible="False"
                Opacity="0"
                InputTransparent="True"
                BackgroundColor="#80000000">

                <ActivityIndicator
                    x:Name="NavigationFeedbackSpinner"
                    IsRunning="False"
                    IsVisible="False"
                    WidthRequest="32"
                    HeightRequest="32"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />
            </Grid>

        </Grid>

    </Grid>
</ContentPage>
