<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <exclude domain="sharedpref" path="joesscanner.protected-credentials.xml" />
    <!-- MAUI AppDataDirectory is FilesDir. Keep the whole SQLite family local. -->
    <exclude domain="file" path="joesscanner.db" />
    <exclude domain="file" path="joesscanner.db-wal" />
    <exclude domain="file" path="joesscanner.db-shm" />
    <exclude domain="file" path="joesscanner.db-journal" />
    <exclude domain="file" path="monitoring-reconnect.v1" />
    <exclude domain="file" path="Logs" />
    <exclude domain="file" path="telemetry-events.json" />
</full-backup-content>
